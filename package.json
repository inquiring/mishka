{
  "name": "mishka",
  "version": "0.1.0",
  "private": true,
  "description": "Личный проект",
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.3",
    "csso": "^5.0.5",
    "editorconfig-checker": "^6.1.1",
    "less": "^4.6.4",
    "playwright": "^1.58.2",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "postcss-nested": "^7.0.2",
    "postcss-simple-vars": "^7.0.1"
  },
  "scripts": {
    "test": "editorconfig-checker -exclude '^(build/|node_modules/|\\.git/|\\.editorconfig$)'",
    "build": "node scripts/build.cjs",
    "serve": "node scripts/serve.cjs",
    "watch": "chokidar \"*.html\" \"css/**\" \"fonts/**/*.{woff,woff2}\" \"img/**\" \"js/**\" \"less/**/*.less\" -c \"npm run build\"",
    "start": "npm run build && concurrently \"npm run serve\" \"npm run watch\""
  },
  "editorconfig-cli": [
    "*.html",
    "*.json",
    "*.js",
    "js/**/*.js",
    "img/**/*.svg",
    "less/**/*.less"
  ],
  "engines": {
    "node": ">=6.10"
  },
  "main": "scripts/build.cjs",
  "keywords": [
    "mishka"
  ],
  "author": "A.S",
  "license": "ISC"
}
